/datum/law/capital_law
	severity = CAPITAL_CRIME
	brig_time = PERMABRIG_SENTENCE

/datum/law/capital_law/attempted_murder
	name = "谋杀未遂"
	desc = "企图谋杀他人但未得逞。证据须表明被捕者明确怀有恶意杀人意图，只是未能完成杀人行为。"

/datum/law/capital_law/desertion
	name = "逃兵行为"
	desc = "拒绝履行岗位的必要职责，或未经授权擅离职守且无意返回。（前线作战基地被攻破时撤离星球不构成逃兵行为，但接到返回命令后拒绝返回则构成。）"

/datum/law/capital_law/jailbreak_escape
	name = "越狱／脱逃"
	desc = "脱逃、协助或企图脱逃，或明知他人劫狱而自愿配合逃离。"

/datum/law/capital_law/murder
	name = "谋杀或未经授权处决"
	desc = "怀有恶意杀害他人，包括摧毁合成人。处决仅可按处决程序规定获得授权。"
	special_punishment = "降职"

/datum/law/capital_law/sedition
	name = "叛乱"
	desc = "实施行动或拒绝服从命令，意图推翻或篡夺合法指挥体系。"

/datum/law/capital_law/crimes_against_humanity
	name = "反人类罪"
	desc = "实施侵犯人权或其他针对人类的严重暴行，例如酷刑、食人，以及强迫他人感染异形幼体。"
