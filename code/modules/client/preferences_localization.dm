/// Present translated choices while returning their original list keys.
/proc/preference_input_list(mob/user, message, title = "选择", list/buttons, timeout = 0, theme = null, default)
	var/list/display_options = list()
	var/default_label
	for(var/option in buttons)
		var/label = "[preference_label(option)]"
		if(label in display_options)
			label += " ([option])"
		display_options[label] = option
		if(option == default)
			default_label = label
	var/choice = tgui_input_list(user, message, preference_label(title), display_options, timeout, theme, default_label)
	if(isnull(choice))
		return null
	return display_options[choice]
