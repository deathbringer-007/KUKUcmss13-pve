/datum/poster/poster_1
	icon_state="poster1"
	name = "“未来”"
	desc = "海报上，日出照耀着网格背景前以矢量风格绘制的群山。你能欣赏到那股复古美学气息。"

/datum/poster/poster_2
	icon_state="poster2"
	name = "独角兽"
	desc = "这张荧光绒面海报画着彩虹下的一只独角兽，下方醒目地写着“毒品”。你年轻时也有一张一模一样的，但你绝不会告诉任何人。"

/datum/poster/poster_3
	icon_state="poster3"
	name = "丽塔"
	desc = "海报上是一位早已逝去的20世纪摇滚歌手。摇滚或许已死，但也曾辉煌一时。"

/datum/poster/poster_4
	icon_state="poster4"
	name = "施瓦辛格总统竞选海报"
	desc = "这张褪色的老海报是施瓦辛格总统竞选海报的复制品。他在第八届任期过半时失踪，此后再无下落。"

/datum/poster/poster_5
	icon_state="poster5"
	name = "贝丝"
	desc = "一张正席卷全国的新晋多白金唱片流行组合贝丝的海报。他们唱得真烂。"

/datum/poster/poster_6
	icon_state="poster6"
	name = "艺术？"
	desc = "见鬼，你也能画出这种东西，然后赚得盆满钵满。"

/datum/poster/poster_7
	icon_state="poster7"
	name = "吃"
	desc = "与其说这是海报，不如说是那些难吃能量棒的广告。"

/datum/poster/poster_8
	icon_state="poster8"
	name = "艾里奥斯动态追踪器"
	desc = "一则民用品牌运动探测器的广告。可靠性不如M314，但重量只有大约一半。"

/datum/poster/poster_9
	icon_state="poster9"
	name = "西格森"
	desc = "嘿，西格森！真是久违的名字。大约在他们的一座空间站因系统故障脱离轨道、坠入行星引力井的那段时期，他们被维兰德-汤谷收购了。"

/datum/poster/poster_10
	icon_state="poster10"
	name = "库尔兰德金装"
	desc = "库尔兰德金装香烟，用心机卷，只为让你享受。"

/datum/poster/poster_11
	icon_state="poster11"
	name = "工作乔伊，你一眼就能认出。"
	desc = "工作乔伊，你一眼就能认出。工作乔伊，你一眼就能认出。工作乔伊，你一眼就能认出。工作乔伊，你一眼就能认出。工作乔伊，你一眼就能认出。"

/datum/poster/poster_12
	icon_state="poster12"
	name = "“一月女郎”海报"
	desc = "海报上是罗克珊·斯特拉斯基，她是《花花公子》2180 年一月号的跨页女郎。别问你怎么知道。"

/datum/poster/poster_13
	icon_state="poster13"
	name = "F-100"
	desc = "新款卡西欧 F-100 手表，拥有两个表盘，分别显示当地时间和舰上时间。"

/datum/poster/poster_14
	icon_state="poster14"
	name = "“铭记木卫一”"
	desc = "褪色的宣传海报骄傲地要求你“铭记木卫一”，画面中央正是这颗卫星。十多年前，针对木卫一维修改装船厂的突击队奇袭，揭开了与大角星人战争的序幕。他们如今也许是盟友，但旧伤难愈。"

/datum/poster/poster_15
	icon_state="poster15"
	name = "脉冲步枪海报"
	desc = "阿玛特战场系统 41 型 A 衍生型一代脉冲步枪。你唯一需要的赏心悦目海报。"

/datum/poster/poster_16
	icon_state="poster16"
	name = "“七月女郎”海报"
	desc = "海报上是站在按摩浴缸里的奥黛丽·雷恩沃特，她是《花花公子》2180 年七月号的跨页女郎。别问你怎么知道。"

/datum/poster/poster_17
	icon_state="poster17"
	name = "“四月女郎”海报"
	desc = "海报上是朱丽叶·西蒙斯，她是《花花公子》2179 年四月号的跨页女郎。别问你怎么知道。"

/datum/poster/poster_18
	icon_state="poster18"
	name = "维兰德-汤谷海报"
	desc = "基本只有一个品牌时，你对品牌忠诚也没多少选择。"

/datum/poster/poster_19
	icon_state = "poster19"
	name = "可疑海报"
	desc = "这张海报将美国殖民地陆战队描述为敌人。"

/datum/poster/poster_20
	icon_state="poster20"
	name = "西奥"
	desc = "海报画着一名核生化防护陆战队员。这些家伙的工作很危险。"

/datum/poster/poster_21
	icon_state="poster21"
	name = "格罗夫斯"
	desc = "海报画着一名核生化防护陆战队员。这些家伙的工作很危险。"

/datum/poster/poster_22
	icon_state="poster22"
	name = "索托"
	desc = "索托。不喝索托的人，大概还会用牙线、爱惜肾脏……怂包。哈瓦那印制。"

/datum/poster/poster_23
	icon_state="poster23"
	name = "艺术？"
	desc = "这海报大概画的是局外几何后现代苦行卑贱社会表现主义艺术……你猜的。"

/datum/poster/poster_24
	icon_state="poster24"
	name = "艺术？"
	desc = "海报画着几条曲线，被某个自命不凡的艺术势利鬼估价超过一千二百万。可惜这只是一张低分辨率印刷品。"

/datum/poster/poster_25
	icon_state="poster25"
	name = "丽塔"
	desc = "海报上是一位早已逝去的20世纪摇滚歌手。摇滚或许已死，但也曾辉煌一时。"

/datum/poster/poster_26
	icon_state="poster26"
	name = "琼"
	desc = "海报上是一位早已逝去的20世纪摇滚歌手。摇滚或许已死，但也曾辉煌一时。"

/datum/poster/poster_27
	icon_state="poster27"
	name = "安全指导"
	desc = "海报画着一名操作砂轮的男子，写着“安全指导：实验室内保持专注”。最近有人争论“指导”英文单词该怎么念，有人担心他们可能已经动手了。"

/datum/poster/poster_28
	icon_state="poster28"
	name = "安全护目镜"
	desc = "海报上是戴着安全帽与醒目护目镜的极简人头，写着“保护双眼”。"

/datum/poster/poster_29
	icon_state="poster29"
	name = "“二月女郎”海报"
	desc = "海报上是米兰达·诺埃尔，她是《花花公子》2180 年二月号的跨页女郎。别问你怎么知道。"

/datum/poster/poster_30
	icon_state="poster30"
	name = "正确搬运"
	desc = "海报画着一名用腿部发力抬箱子的男子，并介绍正确搬运重物的方法。记住，公司不需要腰坏了的工人。"

/datum/poster/poster_31
	icon_state="poster31"
	name = "安全护目镜"
	desc = "海报画着镜片发亮的极简人物，写着“爱护双眼，戴好护目镜”。"

/datum/poster/poster_32
	icon_state="poster32"
	name = "2170—2174 环球先生"
	desc = "海报上是 2170—2174 年环球先生冠军兰斯·麦克唐纳。别问你怎么知道。他长得酷似美国第四十二任总统阿诺德·施瓦辛格。"

/datum/poster/poster_33
	icon_state="poster33"
	name = "2174—2176 环球先生"
	desc = "海报上是 2174—2176 年环球先生冠军罗克韦尔·乔丹。别问你怎么知道。"

/datum/poster/poster_34
	icon_state="poster34"
	name = "2176 年至今环球先生"
	desc = "海报上是现任环球先生卫冕冠军威尔逊·温斯洛。别问你怎么知道。"

/datum/poster/poster_35
	icon_state="poster35"
	name = "随身听"
	desc = "海报画着一台随身听，写着“别忘了带随身听”。"

/datum/poster/poster_36
	icon_state="poster36"
	name = "TAB"
	desc = "海报印着 TAB 标志。这种低热量软饮料几乎从未走出地球，在如此偏远的地方看到广告很奇怪。也许只是有人喜欢这个标志。"

/datum/poster/poster_37
	icon_state="poster37"
	name = "百事可乐"
	desc = "海报印着百事可乐标志。"

/datum/poster/poster_38
	icon_state="poster38"
	name = "MTV"
	desc = "MTV：两百多年来只播放音乐录影带。当代音乐的盗版磁带在外缘地区的以物易物市场能卖出高价。"


/datum/poster/poster_39
	icon_state="poster39"
	name = "“吉米与摩门教徒”启明共鸣巡演海报"
	desc = "“吉米与摩门教徒”是十年前的一支摇滚乐队，由一名男子及其七位妻子组成。耶稣基督后期圣徒教会曾多次公开谴责他们，后来却发现成员既不是摩门教徒，也根本没结婚。那可是音乐界的一大丑闻。"

/datum/poster/poster_40
	icon_state="poster40"
	name = "对第 339 号提案投反对票！对《殖民地保护法》投反对票！"
	desc = "海报要求你反对这项赋予军方全面干涉公司事务权力的新法案。有人认为这是政府越权，另一些人却认为，比起放任巨型企业为所欲为，这只是两害相权取其轻。太空实在太大，汇总投票需要很久；即使通过，也很可能最早到 2186 年才生效。"

/datum/poster/poster_41
	icon_state="poster41"
	name = "陨落猎鹰"
	desc = "第 4 旅第 2 营第 2 连“陨落猎鹰”的宣传材料，由不知名艺术家设计印刷，以扩充该连兵员。"

/datum/poster/upp_1
	icon_state="upp_poster_1"
	name = "群星属于我们"
	desc = "身穿舱外活动服的巨人坚定站立，手中进步人民联盟旗帜迎风飘扬。"

/datum/poster/upp_2
	icon_state="upp_poster_2"
	name = "群星属于我们"
	desc = "风格化描绘的太阳系与群星。"

/datum/poster/upp_3
	icon_state="upp_poster_3"
	name = "相信联盟的力量"
	desc = "风格化描绘的进步人民联盟星徽。"

/datum/poster/upp_4
	icon_state="upp_poster_4"
	name = "联盟保障我们的力量"
	desc = "风格化描绘的进步人民联盟旗帜，配文：“我们的团结是各族人民的梦想。相信联盟的力量。”"

/datum/poster/upp_5
	icon_state="upp_poster_5"
	name = "我们开辟通往群星的道路"
	desc = "身穿联盟武装集体舱外活动服的男子微笑着，没有看你，而是望向海报右上方。"

/datum/poster/upp_6
	icon_state="upp_poster_6"
	name = "军队保卫我们的未来"
	desc = "一名联盟武装集体地面部队士兵持枪戒备，目光坚毅无畏，背景是联盟星徽。"

/datum/poster/upp_7
	icon_state="upp_poster_7"
	name = "人民武装集体是我们的脊梁"
	desc = "联盟武装集体地面部队士兵们坚毅地凝视前方，其中一位是女性，没有人的族裔特征十分明显。"

/datum/poster/upp_7/written_8
	icon_state="upp_poster_8"
	name = "人民武装集体是我们的脊梁"
	desc = "联盟武装集体地面部队士兵们坚毅地凝视前方，其中一位是女性，没有人的族裔特征十分明显。海报写着：“人民武装集体代表全体人民，投身解放与保卫人民联盟的神圣战争。”"

/datum/poster/upp_9
	icon_state="upp_poster_9"
	name = "永远警惕资本主义势力"
	desc = "一只衰朽干瘪、近似利爪的手伸向风格化的太阳，太阳被塑造成联盟星徽。海报写着：“即使资本主义垂死挣扎，我们仍须警惕其势力侵袭。”"


/datum/poster/upp_10
	icon_state="upp_poster_10"
	name = "永远警惕资本主义与帝国主义的走狗"
	desc = "一只被画成秃鹫的扭曲尖叫鹰，将利爪伸向叠有联盟圆徽的地球。海报写着：“美洲联盟无法动摇人民的决心。”"
