/datum/origin/twe
	name = ORIGIN_TWE
	desc = "你出生在三世界帝国境内。"

/datum/origin/twe/blighty
	name = ORIGIN_TWE_BLIGHTY
	desc = "大英帝国的残余重获新生。“英联邦”这个名号，既可以是英国人心中的骄傲，也可以是对过去与当下种种错误的无声羞愧。不论如何，那面破旧的旗帜仍在飘扬。"

/datum/origin/twe/lotrs
	name = ORIGIN_TWE_LOTRS
	desc = "日本仍是三世界帝国的科技中心。对于那些“有幸”生活在它阴影下的人而言，东南亚的每个品牌和每条广告，都彰显着它无处不在的强势影响。"

/datum/origin/twe/solar
	name = ORIGIN_TWE_SOLAR
	desc = "你出生在地球、火星，或太阳系内众多殖民地中的一处。你所经历的生活，要么极尽优渥，要么困苦至极。"

/datum/origin/twe/extrasolar
	name = ORIGIN_TWE_EXTRASOLAR
	desc = "你在三世界帝国最富庶的殖民地，或人烟稀少的边疆殖民地出生长大。故乡的生活教会了你羡慕或怜悯太阳系居民。"
