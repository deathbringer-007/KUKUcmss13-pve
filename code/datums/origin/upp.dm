/datum/origin/upp
	name = ORIGIN_UPP
	desc = "你出生在进步人民联盟。"


/datum/origin/upp/cradle
	name = ORIGIN_UPP_CRADLE
	desc = "你来自地球上的某个成员国，或内环一处高度发达的殖民地，一直向往着边疆冒险。"


/datum/origin/upp/frontier
	name = ORIGIN_UPP_FRONTIERSMAN
	desc = "你来自进步人民联盟星域遥远的外边疆，在洁净而狭窄的舱室里长大，从未见过太阳。"


/datum/origin/upp/volunteer
	name = ORIGIN_UPP_VOLUNTEER
	desc = "你逃离了资本主义的压迫与谎言，通过了所有考核和背景审查，正在争取某个成员国的公民身份。欢迎加入，同志。"


/datum/origin/upp/excanc
	name = ORIGIN_UPP_EXCANC
	desc = "你来自如今已不复存在的中国与亚洲国家合作体。这个曾经强大的殖民势力，在灾难性的犬之战争后被进步人民联盟吞并。"

/datum/origin/upp/canc
	name = ORIGIN_CANC
	desc = "你来自如今已不复存在的中国与亚洲国家合作体。这个曾经强大的殖民势力，在灾难性的犬之战争后被进步人民联盟吞并。你仍在继续战斗。"
