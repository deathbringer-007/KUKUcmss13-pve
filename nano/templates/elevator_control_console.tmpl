<h3>电梯控制台</h3>
<div class="item" style="padding-top: 10px">
	<div class="item">
		{{:data.shuttle_status}}
	</div>
</div>
<div class="item" style="padding-top: 10px">
	<div class="item">
		<div class="itemLabel">
			电梯状态：
		</div>
		<div class="itemContent">
			{{if data.shuttle_state == "idle"}}
				<span class="idle">待机</span>
			{{else data.shuttle_state == "warmup"}}
				<span style="font-weight: bold;color: #336699">启动中</span>
			{{else data.shuttle_state == "in_transit"}}
				<span style="font-weight: bold;color: #336699">运行中</span>
			{{else}}
				<span class="bad">错误</span>
			{{/if}}
		</div>
	</div>
</div>
{{if data.has_docking}}
	<div class="item" style="padding-top: 10px">
		<div class="item">
			<div class="itemLabel">
				对接状态：
			</div>
			<div class="itemContent">
				{{if data.docking_status == "docked"}}
					<span class="good">位于殖民地</span>
				{{else data.docking_status == "docking"}}
					{{if !data.docking_override}}
						<span class="average">正在上升</span>
					{{else}}
						<span class="average">正在上升</span>
					{{/if}}
				{{else data.docking_status == "undocking"}}
					{{if !data.docking_override}}
						<span class="average">正在下降</span>
					{{else}}
						<span class="average">正在下降</span>
					{{/if}}
				{{else data.docking_status == "undocked"}}
					<span class="idle">位于研究实验室</span>
				{{else}}
					<span class="bad">错误</span>
				{{/if}}

			</div>
		</div>
	</div>
{{/if}}

<h3>电梯控制</h3>
<div class="item" style="padding-top: 10px">
	<div class="item">
		<div class="itemContent" style="padding-top: 2px; width: 100%">
			{{:helper.link('使用电梯', 'arrowthickstop-1-e', {'move' : '1'}, data.can_launch? null : 'disabled' , null)}}
		</div>
	</div>
</div>
