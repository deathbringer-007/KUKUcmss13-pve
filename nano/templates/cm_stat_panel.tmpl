<!--
Title: Player statistics viewing panel, pulls data from statistic entities from the game.
Used in: /code/datums/statistics/entities/player_entity.dm
 -->
<div class="item">
    {{if data.round}}
        {{:helper.link('全局', 'home', {'menu' : 0, 'subMenu' : 0, 'dataMenu': 0}, data.menu == 0 ? 'selected' : null)}}
    {{/if}}
</div>
<div class="item">
    {{if data.menu == 0}}
        {{:helper.link('概览', null, {'subMenu' : 0, 'dataMenu': 0}, data.subMenu == 0 ? 'selected' : null)}}
        {{:helper.link('参与者', null, {'subMenu' : 1, 'dataMenu': 0}, data.subMenu == 1 ? 'selected' : null)}}
        {{:helper.link('死亡记录', null, {'subMenu' : 2, 'dataMenu': 0}, data.subMenu == 2 ? 'selected' : null)}}
        {{:helper.link('职业', null, {'subMenu' : 3, 'dataMenu': 0}, data.subMenu == 3 ? 'selected' : null)}}
        {{:helper.link('种姓', null, {'subMenu' : 4, 'dataMenu': 0}, data.subMenu == 4 ? 'selected' : null)}}
        {{:helper.link('武器', null, {'subMenu' : 5, 'dataMenu': 0}, data.subMenu == 5 ? 'selected' : null)}}
    {{else data.menu == 1}}
        {{if data.human}}
            {{:helper.link('人类', null, {'subMenu' : 0, 'dataMenu' : 0}, data.subMenu == 0 ? 'selected' : null)}}
        {{/if}}
        {{if data.xeno}}
            {{:helper.link('异形', null, {'subMenu' : 1, 'dataMenu' : 0}, data.subMenu == 1 ? 'selected' : null)}}
        {{/if}}
    {{/if}}
</div>
{{if data.menu == 1 && data.subMenu != 2}}
    <div class="item">
        {{:helper.link('概览', null, {'dataMenu' : 0}, data.dataMenu == 0 ? 'selected' : null)}}
        {{:helper.link('死亡记录', null, {'dataMenu' : 2}, data.dataMenu == 2 ? 'selected' : null)}}
        {{if data.subMenu == 0}}
            {{:helper.link('武器', null, {'dataMenu' : 3}, data.dataMenu == 3 ? 'selected' : null)}}
            {{:helper.link('身份', null, {'dataMenu' : 4}, data.dataMenu == 4 ? 'selected' : null)}}
            {{:helper.link('勋章', null, {'dataMenu' : 5}, data.dataMenu == 5 ? 'selected' : null)}}
        {{else data.subMenu == 1}}
            {{:helper.link('种姓', null, {'dataMenu' : 3}, data.dataMenu == 3 ? 'selected' : null)}}
            {{:helper.link('王浆', null, {'dataMenu' : 5}, data.dataMenu == 5 ? 'selected' : null)}}
        {{/if}}
    </div>
{{/if}}
<div class="itemLabelClearBoth">
    <b>更新时间： {{:data.current_time}}</b>
</div>
<div class="item">
    {{if data.menu == 0}}
        {{if data.round}}
            {{if data.subMenu == 0}}
                <div class="itemLabelClearBoth">
                    <b>{{:data.round.name}}</b>
                </div>
                <div class="itemLabelClear">
                    地图：
                </div>
                <div class="itemContentSmallRight">
                    {{:data.round.map_name}}
                </div>
                <div class="itemLabelClear">
                    游戏模式：
                </div>
                <div class="itemContentSmallRight">
                    {{:data.round.game_mode}}
                </div>
                {{if data.round.round_result}}
                    <div class="itemLabelClear">
                        结果：
                    </div>
                    <div class="itemContentSmallRight">
                        {{:data.round.round_result}}
                    </div>
                {{/if}}
                <div class="itemLabelClear">
                    回合开始：
                </div>
                <div class="itemContentSmallRight">
                    {{:data.round.real_time_start}}
                </div>
                {{if data.round.real_time_end}}
                    <div class="itemLabelClear">
                        回合结束：
                    </div>
                    <div class="itemContentSmallRight">
                        {{:data.round.real_time_end}}
                    </div>
                {{/if}}
                {{if data.round.round_length}}
                    <div class="itemLabelClear">
                        回合时长：
                    </div>
                    <div class="itemContentSmallRight">
                        {{:data.round.round_length}}
                    </div>
                {{/if}}
                {{if data.round.round_hijack_time}}
                    <div class="itemLabelClear">
                        劫持时间：
                    </div>
                    <div class="itemContentSmallRight">
                        {{:data.round.round_hijack_time}}
                    </div>
                {{/if}}
                {{if data.round.end_round_player_population}}
                    <div class="itemLabelClear">
                        最终玩家人数：
                    </div>
                    <div class="itemContentSmallRight">
                        {{:data.round.end_round_player_population}}
                    </div>
                {{/if}}
                <div class="itemLabelClear">
                    防御戒备等级：
                </div>
                <div class="itemContentSmallRight">
                    {{:data.round.defcon_level}}
                </div>
                {{if data.round.total_objective_points}}
                    <div class="itemLabelClear">
                        目标点数：
                    </div>
                    <div class="itemContentSmallRight">
                        {{:data.round.objective_points}}
                    </div>
                    <div class="itemLabelClear">
                        目标总点数：
                    </div>
                    <div class="itemContentSmallRight">
                        {{:data.round.total_objective_points}}
                    </div>
                {{/if}}
                <div class="itemLabelClear">
                    总射击数：
                </div>
                <div class="itemContentSmallRight">
                    {{:data.round.total_projectiles_fired}}
                </div>
                <div class="itemLabelClear">
                    总命中数：
                </div>
                <div class="itemContentSmallRight">
                    {{:data.round.total_projectiles_hit}}
                </div>
                <div class="itemLabelClear">
                    总命中数（人类）：
                </div>
                <div class="itemContentSmallRight">
                    {{:data.round.total_projectiles_hit_human}}
                </div>
                <div class="itemLabelClear">
                    总命中数（异形）：
                </div>
                <div class="itemContentSmallRight">
                    {{:data.round.total_projectiles_hit_xeno}}
                </div>
                <div class="itemLabelClear">
                    总误伤次数：
                </div>
                <div class="itemContentSmallRight">
                    {{:data.round.total_friendly_fire_instances}}
                </div>
                <div class="itemLabelClear">
                    总误杀数：
                </div>
                <div class="itemLabelClear">
                    总撕砍次数：
                </div>
                <div class="itemContentSmallRight">
                    {{:data.round.total_slashes}}
                </div>
                <div class="itemLabelClear">
                    总抱脸次数：
                </div>
                <div class="itemContentSmallRight">
                    {{:data.round.total_huggers_applied}}
                </div>
                <div class="itemLabelClear">
                    总破胸次数：
                </div>
                <div class="itemContentSmallRight">
                    {{:data.round.total_larva_burst}}
                </div>
            {{else data.subMenu == 1}}
                <div class="itemLabelClearBoth">
                    总参与人数：
                </div>
                <fieldset class="fieldContainerSpaced">
                    {{props data.round.participants}}
                        <div class="itemLabelClear">
                            {{:value.name}}:
                        </div>
                        <div class="itemContentSmallRight">
                            {{:value.value}}
                        </div>
                    {{/props}}
                </fieldset>
                <div class="itemLabelClearBoth">
                    总死亡数：
                </div>
                <fieldset class="fieldContainerSpaced">
                    {{props data.round.total_deaths}}
                        <div class="itemLabelClear">
                            {{:value.name}}:
                        </div>
                        <div class="itemContentSmallRight">
                            {{:value.value}}
                        </div>
                    {{/props}}
                </fieldset>
                {{if data.round.round_hijack_time}}
                    <div class="itemLabelClearBoth">
                        劫持时参与者：
                    </div>
                    <fieldset class="fieldContainerSpaced">
                        {{props data.round.hijack_participants}}
                            <div class="itemLabelClear">
                                {{:value.name}}:
                            </div>
                            <div class="itemContentSmallRight">
                                {{:value.value}}
                            </div>
                        {{/props}}
                    </fieldset>
                {{/if}}
                {{if data.round.real_time_end}}
                    <div class="itemLabelClearBoth">
                        最终参与者：
                    </div>
                    <div class="itemContentSmallRight">
                        <fieldset class="fieldContainerSpaced">
                            {{props data.round.final_participants}}
                                <div class="itemLabelClear">
                                    {{:value.name}}:
                                </div>
                                <div class="itemContentSmallRight">
                                    {{:value.value}}
                                </div>
                            {{/props}}
                        </fieldset>
                    </div>
                {{/if}}
            {{else data.subMenu == 2}}
                {{props data.round.death_stats_list :death_value:death_index}}
                    <fieldset class="fieldContainerSpaced">
                        <div class="itemLabelClearBoth">
                            <b>{{:death_value.mob_name}}</b>
                        </div>
                        {{if death_value.job_name}}
                            <div class="itemLabelClear">
                                身份：
                            </div>
                            <div class="itemContentSmallRight">
                                {{:death_value.job_name}}
                            </div>
                        {{/if}}
                        <div class="itemLabelClear">
                            区域：
                        </div>
                        <div class="itemContentSmallRight">
                            {{:death_value.area_name}}
                        </div>
                        <div class="itemLabelClear">
                            死因：
                        </div>
                        <div class="itemContentSmallRight">
                            {{:death_value.cause_name}}
                        </div>
                        <div class="itemLabelClear">
                            死亡时间：
                        </div>
                        <div class="itemContentSmallRight">
                            {{:death_value.time_of_death}}
                        </div>
                        <div class="itemLabelClear">
                            存活时长：
                        </div>
                        <div class="itemContentSmallRight">
                            {{:death_value.total_time_alive}}
                        </div>
                        <div class="itemLabelClear">
                            所受伤害：
                        </div>
                        <div class="itemContentSmallRight">
                            {{:death_value.total_damage_taken}}
                        </div>
                        <div class="itemLabelClear">
                            坐标：
                        </div>
                        <div class="itemContentSmallRight">
                            ({{:death_value.x}}, {{:death_value.y}}, {{:death_value.z}})
                        </div>
                    </fieldset>
                {{/props}}
            {{else data.subMenu == 3}}
                {{props data.round.job_stats_list :job_value:job_index}}
                    <fieldset class="fieldContainerSpaced">
                        <div class="itemLabelClearBoth">
                            <b>{{:job_value.name}}</b>
                        </div>
                        {{if job_value.total_shots}}
                            <div class="itemLabelClear">
                                总射击数：
                            </div>
                            <div class="itemContentSmallRight">
                                {{:job_value.total_shots}}
                            </div>
                        {{/if}}
                        {{if job_value.total_shots_hit}}
                            <div class="itemLabelClear">
                                总命中数：
                            </div>
                            <div class="itemContentSmallRight">
                                {{:job_value.total_shots_hit}}
                            </div>
                        {{/if}}
                        {{if job_value.total_friendly_fire}}
                            <div class="itemLabelClear">
                                总误伤次数：
                            </div>
                            <div class="itemContentSmallRight">
                                {{:job_value.total_friendly_fire}}
                            </div>
                        {{/if}}
                        {{if job_value.total_revives}}
                            <div class="itemLabelClear">
                                总复苏次数：
                            </div>
                            <div class="itemContentSmallRight">
                                {{:job_value.total_revives}}
                            </div>
                        {{/if}}
                        {{if job_value.total_lives_saved}}
                            <div class="itemLabelClear">
                                总救命次数：
                            </div>
                            <div class="itemContentSmallRight">
                                {{:job_value.total_lives_saved}}
                            </div>
                        {{/if}}
                        {{if job_value.total_screams}}
                            <div class="itemLabelClear">
                                总尖叫次数：
                            </div>
                            <div class="itemContentSmallRight">
                                {{:job_value.total_screams}}
                            </div>
                        {{/if}}
                        {{props job_value.niche_stats :niche_value:niche_index}}
                            <div class="itemLabelClear">
                                {{:niche_value.name}}:
                            </div>
                            <div class="itemContentSmallRight">
                                {{:niche_value.value}}
                            </div>
                        {{/props}}
                        {{if job_value.nemesis}}
                            <div class="itemLabelClearBoth">
                                最常见死因：
                            </div>
                            <fieldset class="fieldContainerSpaced">
                                <div class="itemLabelClearBoth">
                                    <b>{{:job_value.nemesis.name}}</b>
                                </div>
                            </fieldset>
                        {{/if}}
                    </fieldset>
                {{/props}}
            {{else data.subMenu == 4}}
                {{props data.round.caste_stats_list :caste_value:caste_index}}
                    <fieldset class="fieldContainerSpaced">
                        <div class="itemLabelClearBoth">
                            <b>{{:caste_value.name}}<b>
                        </div>
                        {{props caste_value.niche_stats :niche_value:niche_index}}
                            <div class="itemLabelClear">
                                {{:niche_value.name}}:
                            </div>
                            <div class="itemContentSmallRight">
                                {{:niche_value.value}}
                            </div>
                        {{/props}}
						<hr>
                        <div class="itemLabelClearBoth">
                            <b>技能使用次数：</b>
                        </div>
                        {{props caste_value.abilities_used :ability_value:ability_index}}
                            <div class="itemLabelClear">
                                {{:ability_value.name}}:
                            </div>
                            <div class="itemContentSmallRight">
                                {{:ability_value.value}}
                            </div>
                        {{/props}}
                        {{if caste_value.nemesis}}
                            <div class="itemLabelClearBoth">
                                最常见死因：
                            </div>
                            <fieldset class="fieldContainerSpaced">
                                <div class="itemLabelClearBoth">
                                    <b>{{:caste_value.nemesis.name}}</b>
                                </div>
                            </fieldset>
                        {{/if}}
                    </fieldset>
                {{/props}}
            {{else data.subMenu == 5}}
                {{props data.round.weapon_stats_list}}
                    <div class="item">
                        <fieldset class="fieldContainerSpaced">
                            <div class="itemLabelClearBoth">
                                <b>{{:value.name}}</b>
                            </div>
                            {{if value.total_hits}}
                                <div class="itemLabelClear">
                                    总命中数：
                                </div>
                                <div class="itemContentSmallRight">
                                    {{:value.total_hits}}
                                </div>
                            {{/if}}
                            {{if value.total_shots}}
                                <div class="itemLabelClear">
                                    总射击数：
                                </div>
                                <div class="itemContentSmallRight">
                                    {{:value.total_shots}}
                                </div>
                            {{/if}}
                            {{if value.total_shots_hit}}
                                <div class="itemLabelClear">
                                    总命中数：
                                </div>
                                <div class="itemContentSmallRight">
                                    {{:value.total_shots_hit}}
                                </div>
                            {{/if}}
                            {{if value.total_friendly_fire}}
                                <div class="itemLabelClear">
                                    总误伤次数：
                                </div>
                                <div class="itemContentSmallRight">
                                    {{:value.total_friendly_fire}}
                                </div>
                            {{/if}}
                            {{props value.niche_stats :niche_value:niche_index}}
                                <div class="itemLabelClear">
                                    {{:niche_value.name}}:
                                </div>
                                <div class="itemContentSmallRight">
                                    {{:niche_value.value}}
                                </div>
                            {{/props}}
                        </fieldset>
                    </div>
                {{/props}}
            {{/if}}
        {{/if}}
    {{else data.menu == 1}}
        {{if data.subMenu == 0}}
            {{if data.human}}
                {{if data.dataMenu == 0}}
                    <div class="itemLabelClear">
                        总游玩时长：
                    </div>
                    <div class="itemContentSmallRight">
                        {{:data.human.total_playtime}}
                    </div>
                    <div class="itemLabelClear">
                        总参与回合数：
                    </div>
                    <div class="itemContentSmallRight">
                        {{:data.human.total_rounds_played}}
                    </div>
                    <div class="itemLabelClear">
                        总射击数：
                    </div>
                    <div class="itemContentSmallRight">
                        {{:data.human.total_shots}}
                    </div>
                    <div class="itemLabelClear">
                        总命中数：
                    </div>
                    <div class="itemContentSmallRight">
                        {{:data.human.total_shots_hit}}
                    </div>
                    {{if data.human.total_lives_saved}}
                        <div class="itemLabelClear">
                            总误伤次数：
                        </div>
                        <div class="itemContentSmallRight">
                            {{:data.human.total_friendly_fire}}
                        </div>
                    {{/if}}
                    {{if data.human.total_revives}}
                        <div class="itemLabelClear">
                            总复苏次数：
                        </div>
                        <div class="itemContentSmallRight">
                            {{:data.human.total_revives}}
                        </div>
                    {{/if}}
                    {{if data.human.total_lives_saved}}
                        <div class="itemLabelClear">
                            总救命次数：
                        </div>
                        <div class="itemContentSmallRight">
                            {{:data.human.total_lives_saved}}
                        </div>
                    {{/if}}
                    {{if data.human.total_lives_saved}}
                        <div class="itemLabelClear">
                            总尖叫次数：
                        </div>
                        <div class="itemContentSmallRight">
                            {{:data.human.total_screams}}
                        </div>
                    {{/if}}
                    {{props data.human.niche_stats :niche_value:niche_index}}
                        <div class="itemLabelClear">
                            {{:niche_value.name}}:
                        </div>
                        <div class="itemContentSmallRight">
                            {{:niche_value.value}}
                        </div>
                    {{/props}}
                    {{if data.human.top_weapon}}
                        <div class="itemLabelClearBoth">
                            击杀最多的武器：
                        </div>
                        <fieldset class="fieldContainerSpaced">
                            <div class="itemLabelClearBoth">
                                <b>{{:data.human.top_weapon.name}}</b>
                            </div>
                            {{if data.human.top_weapon.total_shots}}
                                <div class="itemLabelClear">
                                    总射击数：
                                </div>
                                <div class="itemContentSmallRight">
                                    {{:data.human.top_weapon.total_shots}}
                                </div>
                            {{/if}}
                            {{if data.human.top_weapon.total_shots_hit}}
                                <div class="itemLabelClear">
                                    总命中数：
                                </div>
                                <div class="itemContentSmallRight">
                                    {{:data.human.top_weapon.total_shots_hit}}
                                </div>
                            {{/if}}
                            {{if data.human.top_weapon.total_hits}}
                                <div class="itemLabelClear">
                                    总命中数：
                                </div>
                                <div class="itemContentSmallRight">
                                    {{:data.human.top_weapon.total_hits}}
                                </div>
                            {{/if}}
                            {{if data.human.top_weapon.total_friendly_fire}}
                                <div class="itemLabelClear">
                                    总误伤次数：
                                </div>
                                <div class="itemContentSmallRight">
                                    {{:data.human.top_weapon.total_friendly_fire}}
                                </div>
                            {{/if}}
                        </fieldset>
                    {{/if}}
                    {{if data.human.nemesis}}
                        <div class="itemLabelClearBoth">
                            最常见死因：
                        </div>
                        <fieldset class="fieldContainerSpaced">
                            <div class="itemLabelClearBoth">
                                <b>{{:data.human.nemesis.name}}</b>
                            </div>
                        </fieldset>
                    {{/if}}
                {{else data.dataMenu == 2}}
                    {{props data.human.death_list :death_value:death_index}}
                        <fieldset class="fieldContainerSpaced">
                            <div class="itemLabelClearBoth">
                                <b>{{:death_value.mob_name}}</b>
                            </div>
                            {{if death_value.job_name}}
                                <div class="itemLabelClear">
                                    身份：
                                </div>
                                <div class="itemContentSmallRight">
                                    {{:death_value.job_name}}
                                </div>
                            {{/if}}
                            <div class="itemLabelClear">
                                区域：
                            </div>
                            <div class="itemContentSmallRight">
                                {{:death_value.area_name}}
                            </div>
                            <div class="itemLabelClear">
                                死因：
                            </div>
                            <div class="itemContentSmallRight">
                                {{:death_value.cause_name}}
                            </div>
                            <div class="itemLabelClear">
                                死亡时间：
                            </div>
                            <div class="itemContentSmallRight">
                                {{:death_value.time_of_death}}
                            </div>
                            <div class="itemLabelClear">
                                存活时长：
                            </div>
                            <div class="itemContentSmallRight">
                                {{:death_value.total_time_alive}}
                            </div>
                            <div class="itemLabelClear">
                                所受伤害：
                            </div>
                            <div class="itemContentSmallRight">
                                {{:death_value.total_damage_taken}}
                            </div>
                            <div class="itemLabelClear">
                                坐标：
                            </div>
                            <div class="itemContentSmallRight">
                                ({{:death_value.x}}, {{:death_value.y}}, {{:death_value.z}})
                            </div>
                        </fieldset>
                    {{/props}}
                {{else data.dataMenu == 3}}
                    {{props data.human.weapon_stats_list}}
                        <div class="item">
                            <fieldset class="fieldContainerSpaced">
                                <div class="itemLabelClearBoth">
                                    <b>{{:value.name}}</b>
                                </div>
                                {{if value.total_hits}}
                                    <div class="itemLabelClear">
                                        总命中数：
                                    </div>
                                    <div class="itemContentSmallRight">
                                        {{:value.total_hits}}
                                    </div>
                                {{/if}}
                                {{if value.total_shots}}
                                    <div class="itemLabelClear">
                                        总射击数：
                                    </div>
                                    <div class="itemContentSmallRight">
                                        {{:value.total_shots}}
                                    </div>
                                {{/if}}
                                {{if value.total_shots_hit}}
                                    <div class="itemLabelClear">
                                        总命中数：
                                    </div>
                                    <div class="itemContentSmallRight">
                                        {{:value.total_shots_hit}}
                                    </div>
                                {{/if}}
                                {{if value.total_friendly_fire}}
                                    <div class="itemLabelClear">
                                        总误伤次数：
                                    </div>
                                    <div class="itemContentSmallRight">
                                        {{:value.total_friendly_fire}}
                                    </div>
                                {{/if}}
                                {{props value.niche_stats :niche_value:niche_index}}
                                    <div class="itemLabelClear">
                                        {{:niche_value.name}}:
                                    </div>
                                    <div class="itemContentSmallRight">
                                        {{:niche_value.value}}
                                    </div>
                                {{/props}}
                            </fieldset>
                        </div>
                    {{/props}}
                {{else data.dataMenu == 4}}
                    {{props data.human.job_stats_list :job_value:job_index}}
                        <fieldset class="fieldContainerSpaced">
                            <div class="itemLabelClearBoth">
                                <b>{{:job_value.name}}</b>
                            </div>
                            <div class="itemLabelClear">
                                总游玩时长：
                            </div>
                            <div class="itemContentSmallRight">
                                {{:job_value.total_playtime}}
                            </div>
                            <div class="itemLabelClear">
                                总参与回合数：
                            </div>
                            <div class="itemContentSmallRight">
                                {{:job_value.total_rounds_played}}
                            </div>
                            {{if job_value.total_shots}}
                                <div class="itemLabelClear">
                                    总射击数：
                                </div>
                                <div class="itemContentSmallRight">
                                    {{:job_value.total_shots}}
                                </div>
                            {{/if}}
                            {{if job_value.total_shots_hit}}
                                <div class="itemLabelClear">
                                    总命中数：
                                </div>
                                <div class="itemContentSmallRight">
                                    {{:job_value.total_shots_hit}}
                                </div>
                            {{/if}}
                            {{if job_value.total_friendly_fire}}
                                <div class="itemLabelClear">
