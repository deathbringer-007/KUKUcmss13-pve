<h3>穿梭机状态</h3>
<div class="item" style="padding-top: 10px">
	{{if data.shuttle_state != "crashed"}}
		<div class="item">
			{{:data.shuttle_status}}
		</div>
		<div class="item">
			{{:data.shuttle_status_message}}
		</div>
	{{/if}}
</div>
<div class="item" style="padding-top: 10px">
	<div class="item">
		<div class="itemLabel">
			引擎状态：
		</div>
		<div class="itemContent">
			{{if data.shuttle_state == "idle"}}
				<span class="idle">待机</span>
			{{else data.shuttle_state == "warmup"}}
				<span style="font-weight: bold;color: #336699">预热中</span>
			{{else data.shuttle_state == "in_transit"}}
				<span style="font-weight: bold;color: #339933">工作中</span>
			{{else}}
				<span class="bad">错误</span>
			{{/if}}
		</div>
		{{if data.shuttle_state != "crashed" && data.recharge_time > 0}}
			{{if data.shuttle_state == "idle"}}
				<div class="line">
					<div class="statusLabel">充能状态：</div>
					{{if data.recharging > 0}}
						{{if data.optimized}}
							{{:helper.displayBar(data.recharge_status, 0, data.recharge_time, 'average')}}
						{{else}}
							{{:helper.displayBar(data.recharge_status, 0, data.recharge_time, 'bad')}}
						{{/if}}
						<div class="line">
							穿梭机引擎将在 {{:data.recharging_seconds}} 秒后完成充能。
						</div>
					{{else}}
						{{:helper.displayBar(data.recharge_time, 0, data.recharge_time, 'good')}}
						<div class="line">
							穿梭机引擎已准备就绪。
						</div>
					{{/if}}
				</div>
			{{else}}
				<div class="line">
					穿梭机引擎正在工作。&nbsp;
					{{if data.flight_seconds}}
						剩余行程时间： {{:data.flight_seconds}}&nbsp;
					{{/if}}
					{{if data.can_return_home}}
						{{:helper.link('中止飞掠', 'cancel', {'cancel_flyby' : '1'}, null , null)}}
					{{/if}}
				</div>
			{{/if}}
		{{/if}}
	</div>
</div>


{{if data.has_docking && data.shuttle_state != "crashed"}}
	<div class="item" style="padding-top: 10px">
		<div class="item">
			<div class="itemLabel">
				对接状态：
			</div>
			<div class="itemContent">
				{{if data.docking_status == "docked"}}
					<span class="good">已对接</span>
				{{else data.docking_status == "docking"}}
					{{if !data.docking_override}}
						<span class="average">正在对接</span>
					{{else}}
						<span class="average">正在手动对接</span>
					{{/if}}
				{{else data.docking_status == "undocking"}}
					{{if !data.docking_override}}
						<span class="average">正在脱离</span>
					{{else}}
						<span class="average">正在手动脱离</span>
					{{/if}}
				{{else data.docking_status == "undocked"}}
					<span class="idle">已脱离</span>
				{{else}}
					<span class="bad">错误</span>
				{{/if}}

			</div>
		</div>
	</div>
{{/if}}

{{if data.shuttle_state != "crashed"}}
	<div style="padding-top: 10px">
		<h3>穿梭机控制</h3>
		<div class="item">
			<div class="itemContent" style="padding-top: 2px; width: 100%">
				{{:helper.link('启动穿梭机', 'arrowthickstop-1-e', {'move' : '1'}, data.can_launch? null : 'disabled' , null)}}
				<!-- {{:helper.link('Cancel Launch', 'cancel', {'cancel' : '1'}, data.can_cancel ? null : 'disabled' , null)}}
				{{:helper.link('Force Launch', 'alert', {'force' : '1'}, data.can_force? null : 'disabled' , data.can_force ? 'redButton' : null)}} -->
				{{if data.human_user}}
					{{if data.optimize_allowed == 1}}
						{{:helper.link('优化飞行程序', 'refresh', {'optimize' : '1'}, data.can_optimize ? null : 'disabled' , null)}}
					{{/if}}
					{{if data.onboard && data.gun_mission_allowed == 1}}
						{{:helper.link('切换飞行类型', 'refresh', {'fire_mission' : '1'}, data.shuttle_state == "idle" ? null : 'disabled' , null)}}
					{{/if}}
				{{/if}}
			</div>
		</div>
	</div>
{{/if}}

{{if data.human_user && data.is_dropship}}
	<div style="padding-top: 10px">
		<h3>自动起飞</h3>
		{{if data.automated}}
			{{if data.shuttle_state == "idle" && !data.recharging}}
				<div class="line">
				穿梭机将在 {{:data.auto_time_cdown}} 秒后自动起飞
				</div>
			{{else}}
				自动起飞延迟： {{:data.auto_time}} （从充能完成时算起）
			{{/if}}
		{{/if}}
		{{:helper.link('切换自动起飞', 'clock', {'toggle-automated' : '1'}, null, null)}}
	</div>
	{{if data.onboard}}
		<div style="padding-top: 10px">
			<h3>舱门控制</h3>
			{{:helper.link('切换左侧舱门', 'locked', {'side door' : '1', 'right side' : '0'}, null , null)}}
			{{:helper.link('切换右侧舱门', 'locked', {'side door' : '1', 'right side' : '1'}, null , null)}}
			{{:helper.link('切换后舱门', 'locked', {'rear door' : '1'}, null, null)}}
		</div>
		<div style="padding-top: 10px">
			<h3>封锁</h3>
			{{:helper.link('封锁', 'locked', {'lockdown' : '1'}, null , null)}}
			{{:helper.link('解除封锁', 'locked', {'release' : '1'}, null , null)}}
		</div>
	{{/if}}
{{/if}}
